<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div role="alert" class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
      <ul class="list-disc space-y-0.5 pl-4">
        <% project.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome do projeto", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
    <%= f.text_field :name, placeholder: "ex. acta", autofocus: true, class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
    <p class="mt-1.5 text-xs text-zinc-500">Vira o nome do comando: <span class="font-mono text-emerald-400">/antired &lt;nome&gt;</span></p>
  </div>

  <%= f.submit "Criar projeto", class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-400" %>
<% end %>
