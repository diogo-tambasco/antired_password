<% content_for :title, @project.name %>

<div class="min-h-screen">
  <%= render "shared/appnav" %>

  <main class="mx-auto max-w-3xl px-4 py-8">
    <%= render "shared/flash" %>

    <div class="mb-6 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-zinc-500">📦</span>
          <h1 class="truncate text-xl font-semibold tracking-tight text-white"><%= @project.name %></h1>
        </div>
        <p class="mt-1 text-sm text-zinc-500"><%= pluralize(@env_pairs.size, "variável", "variáveis") %> de ambiente · <%= @entries.size %> itens no total</p>
      </div>
      <%= button_to "Remover", project_path(@project), method: :delete, form: { data: { turbo_confirm: "Remover o projeto? Os segredos continuam no cofre (só desagrupados)." } }, class: "shrink-0 cursor-pointer rounded-lg px-3 py-1.5 text-sm font-medium text-red-400 transition hover:bg-red-500/10" %>
    </div>

    <%# ── Puxar com /antired ───────────────────────────────────────────── %>
    <section class="mb-6 rounded-2xl border border-emerald-500/20 bg-emerald-500/[0.04] p-5">
      <h2 class="mb-2 flex items-center gap-2 text-sm font-semibold text-emerald-300"><span>⚡</span> Puxar com a skill</h2>
      <p class="mb-3 text-sm text-zinc-400">No diretório do projeto, com a skill instalada e um token configurado:</p>
      <pre class="overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 font-mono text-sm text-emerald-300 select-all">/antired <%= @project.name.downcase %></pre>
      <p class="mt-2 text-xs text-zinc-500">Sem token ainda? <%= link_to "Criar um token", access_tokens_path, class: "text-emerald-400 hover:underline" %>.</p>
    </section>

    <%# ── .env do projeto ──────────────────────────────────────────────── %>
    <section class="mb-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-zinc-200"><span class="font-mono">.env</span> deste projeto</h2>
        <% if @env_pairs.any? %>
          <input id="reveal_env" type="checkbox" class="peer sr-only">
          <label for="reveal_env" class="cursor-pointer select-none text-xs font-medium text-emerald-400 transition hover:text-emerald-300">👁 Revelar / ocultar</label>
          <pre class="order-last mt-3 w-full basis-full overflow-x-auto whitespace-pre-wrap break-all rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3.5 font-mono text-sm text-emerald-300 blur-sm transition select-all peer-checked:blur-none"><%= @env_text %></pre>
        <% end %>
      </div>
      <% unless @env_pairs.any? %>
        <p class="text-sm text-zinc-500">Nenhuma variável de ambiente ainda. Importe um <span class="font-mono">.env</span> abaixo, ou adicione segredos do tipo <span class="font-mono">env</span> a este projeto.</p>
      <% end %>
    </section>

    <%# ── Importar .env ────────────────────────────────────────────────── %>
    <section class="mb-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
      <h2 class="mb-1 text-sm font-semibold text-zinc-200">Importar <span class="font-mono">.env</span></h2>
      <p class="mb-3 text-xs text-zinc-500">Cole um arquivo <span class="font-mono">.env</span> inteiro — cada <span class="font-mono">KEY=VALUE</span> vira um segredo cifrado. Reimportar atualiza valores existentes.</p>
      <%= form_with url: import_env_project_path(@project), method: :post, class: "space-y-3" do %>
        <%= text_area_tag :env_text, nil, rows: 5, placeholder: "DATABASE_URL=postgres://...\nSECRET_KEY_BASE=...\nSTRIPE_KEY=sk_live_...", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 font-mono text-sm text-zinc-100 placeholder-zinc-600 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
        <%= submit_tag "Importar e cifrar", class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-100 transition hover:bg-zinc-700" %>
      <% end %>
    </section>

    <%# ── Itens do projeto ─────────────────────────────────────────────── %>
    <section>
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-zinc-200">Itens neste projeto</h2>
        <%= link_to "+ Adicionar segredo", new_vault_entry_path, class: "text-sm font-medium text-emerald-400 hover:text-emerald-300" %>
      </div>
      <% if @entries.empty? %>
        <p class="rounded-xl border border-dashed border-zinc-800 bg-zinc-900/40 px-4 py-6 text-center text-sm text-zinc-500">Nenhum item ainda.</p>
      <% else %>
        <ul class="space-y-2">
          <% @entries.each do |entry| %>
            <li>
              <%= link_to vault_entry_path(entry), class: "group flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900/60 px-4 py-3 transition hover:border-zinc-700 hover:bg-zinc-900" do %>
                <div class="flex min-w-0 items-center gap-2">
                  <span class="truncate font-mono text-sm text-zinc-100"><%= entry.name %></span>
                  <span class="inline-flex shrink-0 items-center rounded-full bg-zinc-800 px-2 py-0.5 text-xs font-medium text-zinc-400"><%= entry.kind %></span>
                </div>
                <span class="ml-3 shrink-0 text-zinc-600 transition group-hover:text-emerald-400">→</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </main>
</div>
