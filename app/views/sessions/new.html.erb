<% content_for :title, "Entrar" %>

<div class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-2xl ring-1 ring-emerald-500/30">🔐</div>
      <%= render "shared/wordmark", size_classes: "text-2xl sm:text-3xl" %>
      <h1 class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500">Destrancar o cofre</h1>
      <p class="mt-3 text-sm text-zinc-400">Entre com seu e-mail e a master password.</p>
    </div>

    <% if flash[:alert] %>
      <div role="alert" class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300"><%= flash[:alert] %></div>
    <% end %>

    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 shadow-2xl">
      <%= form_with url: session_path, method: :post, class: "space-y-4" do %>
        <div>
          <%= label_tag :email_address, "E-mail", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
          <%= email_field_tag :email_address, params[:email_address], required: true, autofocus: true, autocomplete: "username", placeholder: "voce@exemplo.com", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
        </div>
        <div>
          <%= label_tag :master_password, "Master password", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
          <%= password_field_tag :master_password, nil, required: true, autocomplete: "current-password", placeholder: "••••••••••••", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
        </div>
        <%= submit_tag "Entrar", class: "inline-flex w-full cursor-pointer items-center justify-center rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50" %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-zinc-400">
      Não tem conta? <%= link_to "Criar conta", signup_path, class: "font-medium text-emerald-400 hover:text-emerald-300" %>
    </p>
  </div>
</div>
