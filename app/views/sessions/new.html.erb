<% content_for :title, "Entrar" %>

<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<h1>Entrar</h1>

<%= form_with url: session_path, method: :post do %>
  <div>
    <%= label_tag :email_address, "E-mail" %>
    <%= email_field_tag :email_address, params[:email_address], required: true, autofocus: true, autocomplete: "username" %>
  </div>

  <div>
    <%= label_tag :master_password, "Master password" %>
    <%= password_field_tag :master_password, nil, required: true, autocomplete: "current-password" %>
  </div>

  <div>
    <%= submit_tag "Entrar" %>
  </div>
<% end %>

<p><%= link_to "Criar conta", signup_path %></p>
