<% if flash[:notice] %>
  <div role="status" class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div role="alert" class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300"><%= flash[:alert] %></div>
<% end %>
