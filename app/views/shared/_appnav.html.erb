<%# Header de navegação do app (autenticado). Usado em cofre / projetos / tokens. %>
<header class="sticky top-0 z-10 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-4">
    <div class="flex items-center gap-4">
      <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
        <span class="text-lg">🔐</span>
        <span class="hidden sm:inline"><%= render "shared/wordmark", size_classes: "text-lg" %></span>
      <% end %>
      <nav class="flex items-center gap-1 text-sm">
        <%= link_to "Cofre", vault_entries_path, class: nav_class(controller_name == "vault_entries") %>
        <%= link_to "Projetos", projects_path, class: nav_class(controller_name == "projects") %>
        <%= link_to "Tokens", access_tokens_path, class: nav_class(controller_name == "access_tokens") %>
      </nav>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <span class="hidden text-zinc-400 md:inline"><%= current_user.email_address %></span>
      <%= button_to "Sair", session_path, method: :delete, class: "cursor-pointer rounded-lg px-3 py-1.5 text-zinc-300 transition hover:bg-zinc-800 hover:text-white" %>
    </div>
  </div>
</header>
