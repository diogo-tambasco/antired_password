<%= form_with model: @entry, url: url, method: method, class: "space-y-5" do |f| %>
  <% if @entry.errors.any? %>
    <div role="alert" class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
      <ul class="list-disc space-y-0.5 pl-4">
        <% @entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
    <%= f.text_field :name, placeholder: "ex. Acta Supabase service key", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :kind, "Tipo", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
    <%= f.select :kind,
        VaultEntry.kinds.keys.map { |k| [k.humanize, k] },
        { selected: @entry.kind },
        { class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" } %>
  </div>

  <div>
    <%= f.label :project_id, "Projeto", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
    <%= f.collection_select :project_id, current_user.projects.order(:name), :id, :name,
        { include_blank: "— sem projeto —" },
        { class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" } %>
    <p class="mt-1.5 text-xs text-zinc-500">Pra virar variável no <span class="font-mono">.env</span>: tipo <span class="font-mono">Env</span> + o <span class="font-mono">name</span> é a chave (ex. <span class="font-mono">DATABASE_URL</span>).</p>
  </div>

  <div>
    <%= label_tag "vault_entry[value]", "Valor (segredo)", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
    <%= text_area_tag "vault_entry[value]", nil, rows: 4, placeholder: "cole o segredo aqui…", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 font-mono text-sm text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
    <% if @entry.persisted? %>
      <p class="mt-1.5 text-xs text-zinc-500">Deixe em branco pra manter o valor atual.</p>
    <% end %>
  </div>

  <%= f.submit(@entry.persisted? ? "Salvar alterações" : "Guardar segredo", class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50") %>
<% end %>
