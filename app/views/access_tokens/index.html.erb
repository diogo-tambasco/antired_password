<% content_for :title, "Tokens" %>

<div class="min-h-screen">
  <%= render "shared/appnav" %>

  <main class="mx-auto max-w-3xl px-4 py-8">
    <%= render "shared/flash" %>

    <% if @new_token.present? %>
      <div class="mb-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/[0.06] p-5">
        <h2 class="mb-1 flex items-center gap-2 text-sm font-semibold text-emerald-300"><span>🔑</span> Seu novo token</h2>
        <p class="mb-3 text-xs text-zinc-400">Copie agora — por segurança ele <strong>não aparece de novo</strong>.</p>
        <pre class="overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 font-mono text-sm text-emerald-300 select-all"><%= @new_token %></pre>
        <div class="mt-4 space-y-1.5 text-xs text-zinc-400">
          <p class="font-medium text-zinc-300">Configurar a skill (uma vez, no seu terminal):</p>
          <pre class="overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-2.5 font-mono text-zinc-300 select-all">antired login <%= request.base_url %> <%= @new_token %></pre>
        </div>
      </div>
    <% end %>

    <div class="mb-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
      <h1 class="mb-1 text-base font-semibold text-white">Gerar token de acesso</h1>
      <p class="mb-4 text-xs text-zinc-500">Tokens deixam a skill <span class="font-mono text-emerald-400">/antired</span> puxar segredos sem master password. <span class="text-amber-400/80">Nesta versão um token lê todo o seu cofre pessoal</span> (escopo por projeto vem depois). Revogável a qualquer momento.</p>
      <%= form_with url: access_tokens_path, method: :post, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do %>
        <div class="flex-1">
          <%= label_tag :name, "Rótulo", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
          <%= text_field_tag :name, nil, placeholder: "ex. macbook-diogo", class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 placeholder-zinc-500 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
        </div>
        <div class="w-full sm:w-40">
          <%= label_tag :expires_in_days, "Expira em (dias)", class: "mb-1.5 block text-sm font-medium text-zinc-400" %>
          <%= number_field_tag :expires_in_days, 90, min: 1, class: "block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-zinc-100 shadow-sm transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 focus:outline-none" %>
        </div>
        <%= submit_tag "Gerar token", class: "inline-flex shrink-0 cursor-pointer items-center justify-center rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-400" %>
      <% end %>
      <p class="mt-2 text-xs text-zinc-600">Em branco = nunca expira (não recomendado).</p>
    </div>

    <h2 class="mb-3 text-sm font-semibold text-zinc-200">Tokens ativos</h2>
    <% if @tokens.empty? %>
      <p class="rounded-xl border border-dashed border-zinc-800 bg-zinc-900/40 px-4 py-6 text-center text-sm text-zinc-500">Nenhum token ainda.</p>
    <% else %>
      <ul class="space-y-2">
        <% @tokens.each do |token| %>
          <li class="flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900/60 px-4 py-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="truncate font-medium text-zinc-100"><%= token.name %></span>
                <% if token.expired? %>
                  <span class="inline-flex shrink-0 items-center rounded-full bg-red-500/15 px-2 py-0.5 text-xs font-medium text-red-300">expirado</span>
                <% end %>
              </div>
              <p class="mt-0.5 text-xs text-zinc-500">
                <span class="font-mono">antp_<%= token.public_id %>_…</span>
                · criado <%= token.created_at.strftime("%d/%m %H:%M") %><%
                %><% if token.expires_at %> · expira <%= token.expires_at.strftime("%d/%m/%Y") %><% end %><%
                %><% if token.last_used_at %> · usado <%= token.last_used_at.strftime("%d/%m %H:%M") %><% end %>
              </p>
            </div>
            <%= button_to "Revogar", access_token_path(token), method: :delete, form: { data: { turbo_confirm: "Revogar este token? Quem o usa perde acesso na hora." } }, class: "shrink-0 cursor-pointer rounded-lg px-3 py-1.5 text-sm font-medium text-red-400 transition hover:bg-red-500/10" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </main>
</div>
